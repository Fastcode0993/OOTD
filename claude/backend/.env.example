# MongoDB 연결 URI
# Atlas 예시: mongodb+srv://user:password@cluster.mongodb.net/personal_color
MONGODB_URI=mongodb://localhost:27017/personal_color

# 서버 포트
PORT=5000

# Node 환경
NODE_ENV=development

# 클라우드 앱 프론트엔드 URL (CORS 허용 Origin)
CLIENT_URL=http://localhost:3000

# 키오스크 API 키 (POST /save-diagnosis 인증)
KIOSK_API_KEY=kiosk-dev-key-2024
